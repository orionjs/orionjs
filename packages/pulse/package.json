{
  "name": "@orion-js/pulse",
  "version": "4.5.17",
  "description": "Distributed, recoverable pub/sub backed by MongoDB",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "author": "nicolaslopezj",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "bun test",
    "test:stress": "bun run scripts/stress-batching.ts",
    "prepack": "bun run build",
    "clean": "rm -rf ./dist",
    "build": "tsup && bun run ../../scripts/emit-declarations.ts",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "uuidv7": "^1.2.1"
  },
  "peerDependencies": {
    "mongodb": "^6.15.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^18.19.86",
    "mongodb": "6.15.0",
    "mongodb-memory-server": "^10.1.4",
    "tsup": "^8.0.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
