{
  "name": "@orion-js/dogs",
  "version": "4.6.6",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "author": "nicolaslopezj",
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "stress:acquisition": "DOGS_RUN_STRESS_TEST=1 bun test --cwd ../.. packages/dogs/scripts/stress-job-acquisition.test.ts",
    "stress:scheduling": "DOGS_RUN_STRESS_TEST=1 bun test --cwd ../.. packages/dogs/scripts/stress-bulk-scheduling.test.ts",
    "prepack": "bun run build",
    "clean": "rm -rf ./dist",
    "build": "tsup && bun run ../../scripts/emit-declarations.ts",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@orion-js/helpers": "4.5.0",
    "@orion-js/schema": "4.5.0",
    "@orion-js/services": "4.5.0",
    "@orion-js/typed-model": "4.5.0",
    "cron-parser": "^5.5.0",
    "dataloader": "2.2.2",
    "dot-object": "^2.1.5",
    "parse-duration": "^2.1.3"
  },
  "peerDependencies": {
    "@orion-js/logger": "4.5.0",
    "@orion-js/mongodb": "4.5.2"
  },
  "devDependencies": {
    "@orion-js/logger": "4.5.0",
    "@orion-js/mongodb": "4.5.2",
    "mongodb-memory-server": "^10.1.4",
    "tsup": "^8.0.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "2d14bc085d49a33b2a5566bec1caf60c7d0f897e"
}
